# SMTP Settings for Nodemailer Email Routing
# Rename this file to '.env' and fill in your credentials to receive real emails.

# The SMTP host of your email provider (e.g. smtp.gmail.com for Gmail, smtp.mailgun.org, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Your email address and SMTP password (use Gmail App Password for Gmail)
# How to get Gmail App Password: https://support.google.com/accounts/answer/185833
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# The destination address where contact submissions will be received
CONTACT_RECEIVER_EMAIL=heritier.serutamba@gmail.com

# Server configuration
PORT=5000
